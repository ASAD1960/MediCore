{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "medicore-backend": {
      "root": "medicore-backend",
      "framework": "express"
    },
    "medicore-frontend": {
      "root": "medicore-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "medicore-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "medicore-frontend"
      }
    }
  ]
}