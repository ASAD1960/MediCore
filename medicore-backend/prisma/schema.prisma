generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum OrgType {
  HOSPITAL
  CLINIC
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum ConsultationStatus {
  DRAFT
  FINALIZED
  AMENDED
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
  DISPENSED
  VOIDED
}

enum LabOrderStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  RESULT_ENTERED
  VERIFIED
  CANCELLED
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  FAILED
}

enum StockMovementType {
  PURCHASE
  DISPENSE
  ADJUSTMENT
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  timezone           String       @default("UTC") @db.VarChar(64)
  organizationType   OrgType      @default(CLINIC)
  registrationNumber String?      @unique
  email              String?
  phone              String?
  address            String?
  logoUrl            String?
  status             RecordStatus @default(ACTIVE)
  patientSeq         Int          @default(0)
  invoiceSeq         Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  branches           Branch[]
  users              User[]
  roles              Role[]
  departments        Department[]
  patients           Patient[]
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model User {
  id              String        @id @default(cuid())
  organizationId  String?
  branchId        String?
  name            String
  email           String        @unique
  passwordHash    String
  phone           String?
  status          RecordStatus  @default(ACTIVE)
  isPlatformAdmin Boolean       @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  doctor          Doctor?
  employee        Employee?

  @@index([organizationId])
}

model Role {
  id              String           @id @default(cuid())
  organizationId  String?
  name            String
  description     String?
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  doctors        Doctor[]
  employees      Employee[]

  @@unique([organizationId, name])
}

model Employee {
  id             String       @id @default(cuid())
  organizationId String
  userId         String       @unique
  departmentId   String?
  designation    String?
  hireDate       DateTime?
  status         RecordStatus @default(ACTIVE)
  user           User         @relation(fields: [userId], references: [id])
  department     Department?  @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
}

model Doctor {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String           @unique
  departmentId    String
  licenseNumber   String
  specialization  String
  qualification   String?
  consultationFee Decimal          @default(0) @db.Decimal(12, 2)
  experienceYears Int              @default(0)
  status          RecordStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  department      Department       @relation(fields: [departmentId], references: [id])
  schedules       DoctorSchedule[]
  appointments    Appointment[]
  consultations   Consultation[]
  prescriptions   Prescription[]
  admissions      Admission[]

  @@unique([organizationId, licenseNumber])
  @@index([organizationId])
}

model DoctorSchedule {
  id             String @id @default(cuid())
  organizationId String
  doctorId       String
  dayOfWeek      Int
  startTime      String
  endTime        String
  slotMinutes    Int    @default(15)
  doctor         Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([organizationId, doctorId])
}

model Patient {
  id                    String          @id @default(cuid())
  organizationId        String
  patientNumber         String
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                Gender
  phone                 String
  email                 String?
  address               String?
  bloodGroup            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  status                RecordStatus    @default(ACTIVE)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization    @relation(fields: [organizationId], references: [id])
  appointments          Appointment[]
  encounters            Encounter[]
  allergies             Allergy[]
  medicalRecords        MedicalRecord[]
  labOrders             LabOrder[]
  admissions            Admission[]
  invoices              Invoice[]
  queueEntries          QueueEntry[]

  @@unique([organizationId, patientNumber])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, phone])
}

model Appointment {
  id              String            @id @default(cuid())
  organizationId  String
  patientId       String
  doctorId        String
  branchId        String?
  appointmentDate DateTime          @db.Date
  startTime       DateTime
  endTime         DateTime
  appointmentType String            @default("CONSULTATION")
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  createdBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  queueEntries    QueueEntry[]

  @@index([organizationId, doctorId, startTime, endTime])
  @@index([organizationId, appointmentDate])
}

model QueueEntry {
  id             String       @id @default(cuid())
  organizationId String
  patientId      String
  appointmentId  String?
  queueNumber    Int
  queueDate      DateTime     @db.Date
  status         QueueStatus  @default(WAITING)
  createdAt      DateTime     @default(now())
  patient        Patient      @relation(fields: [patientId], references: [id])
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([organizationId, queueDate])
}

model Encounter {
  id             String         @id @default(cuid())
  organizationId String
  patientId      String
  appointmentId  String?
  encounterType  String         @default("OUTPATIENT")
  startedAt      DateTime       @default(now())
  endedAt        DateTime?
  patient        Patient        @relation(fields: [patientId], references: [id])
  consultations  Consultation[]

  @@index([organizationId, patientId])
}

model Consultation {
  id                 String             @id @default(cuid())
  organizationId     String
  encounterId        String
  doctorId           String
  patientId          String
  chiefComplaint     String?
  clinicalNotes      String?
  diagnosis          String?
  treatmentPlan      String?
  consultationStatus ConsultationStatus @default(DRAFT)
  finalizedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  encounter          Encounter          @relation(fields: [encounterId], references: [id])
  doctor             Doctor             @relation(fields: [doctorId], references: [id])
  diagnoses          Diagnosis[]
  prescriptions      Prescription[]

  @@index([organizationId, patientId])
}

model Diagnosis {
  id             String       @id @default(cuid())
  organizationId String
  consultationId String
  code           String?
  description    String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Allergy {
  id             String  @id @default(cuid())
  organizationId String
  patientId      String
  allergen       String
  reaction       String?
  severity       String?
  patient        Patient @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
}

model MedicalRecord {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  recordType     String
  title          String
  content        String?
  recordedBy     String?
  recordedAt     DateTime @default(now())
  patient        Patient  @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId, recordedAt])
}

model Prescription {
  id                 String             @id @default(cuid())
  organizationId     String
  patientId          String
  consultationId     String
  doctorId           String
  prescriptionNumber String
  instructions       String?
  status             PrescriptionStatus @default(DRAFT)
  issuedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  consultation       Consultation       @relation(fields: [consultationId], references: [id])
  doctor             Doctor             @relation(fields: [doctorId], references: [id])
  items              PrescriptionItem[]

  @@unique([organizationId, prescriptionNumber])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medicineId     String
  dosage         String
  frequency      String
  durationDays   Int
  quantity       Int
  notes          String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
}

model Medicine {
  id                String             @id @default(cuid())
  organizationId    String
  name              String
  genericName       String?
  category          String?
  unit              String             @default("tablet")
  unitPrice         Decimal            @default(0) @db.Decimal(12, 2)
  reorderLevel      Int                @default(10)
  status            RecordStatus       @default(ACTIVE)
  batches           MedicineBatch[]
  prescriptionItems PrescriptionItem[]

  @@unique([organizationId, name])
}

model MedicineBatch {
  id             String          @id @default(cuid())
  organizationId String
  medicineId     String
  batchNumber    String
  quantity       Int
  expiryDate     DateTime        @db.Date
  purchasePrice  Decimal         @default(0) @db.Decimal(12, 2)
  receivedAt     DateTime        @default(now())
  medicine       Medicine        @relation(fields: [medicineId], references: [id])
  movements      StockMovement[]

  @@unique([organizationId, medicineId, batchNumber])
  @@index([organizationId, expiryDate])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  batchId        String
  movementType   StockMovementType
  quantity       Int
  reference      String?
  createdBy      String?
  createdAt      DateTime          @default(now())
  batch          MedicineBatch     @relation(fields: [batchId], references: [id])

  @@index([organizationId, batchId])
}

model LabTest {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  name           String
  price          Decimal        @default(0) @db.Decimal(12, 2)
  referenceRange String?
  status         RecordStatus   @default(ACTIVE)
  orderItems     LabOrderItem[]

  @@unique([organizationId, code])
}

model LabOrder {
  id             String         @id @default(cuid())
  organizationId String
  patientId      String
  requestedBy    String
  requestNumber  String
  status         LabOrderStatus @default(REQUESTED)
  createdAt      DateTime       @default(now())
  patient        Patient        @relation(fields: [patientId], references: [id])
  items          LabOrderItem[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
}

model LabOrderItem {
  id         String     @id @default(cuid())
  labOrderId String
  labTestId  String
  order      LabOrder   @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  test       LabTest    @relation(fields: [labTestId], references: [id])
  result     LabResult?
}

model LabResult {
  id             String       @id @default(cuid())
  organizationId String
  labOrderItemId String       @unique
  value          String
  unit           String?
  enteredBy      String
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())
  item           LabOrderItem @relation(fields: [labOrderItemId], references: [id])
}

model Ward {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  wardType       String?
  beds           Bed[]

  @@unique([organizationId, name])
}

model Bed {
  id             String       @id @default(cuid())
  organizationId String
  wardId         String
  bedNumber      String
  status         RecordStatus @default(ACTIVE)
  ward           Ward         @relation(fields: [wardId], references: [id])
  admissions     Admission[]

  @@unique([wardId, bedNumber])
}

model Admission {
  id               String          @id @default(cuid())
  organizationId   String
  patientId        String
  doctorId         String
  bedId            String
  status           AdmissionStatus @default(ADMITTED)
  admittedAt       DateTime        @default(now())
  dischargedAt     DateTime?
  dischargeSummary String?
  patient          Patient         @relation(fields: [patientId], references: [id])
  doctor           Doctor          @relation(fields: [doctorId], references: [id])
  bed              Bed             @relation(fields: [bedId], references: [id])
  // BR-14: enforce one active admission per bed via partial unique index in migration:
  // CREATE UNIQUE INDEX one_active_admission_per_bed ON "Admission"("bedId") WHERE status = 'ADMITTED';

  @@index([organizationId, status])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  patientId      String
  invoiceNumber  String
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount  Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  issuedAt       DateTime?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  patient        Patient       @relation(fields: [patientId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]

  @@unique([organizationId, invoiceNumber])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  itemType    String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String        @id @default(cuid())
  organizationId   String
  invoiceId        String
  paymentReference String
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    String
  paymentStatus    PaymentStatus @default(COMPLETED)
  receivedBy       String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
  refunds          Refund[]

  @@unique([organizationId, paymentReference])
}

model Refund {
  id             String   @id @default(cuid())
  organizationId String
  paymentId      String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  processedBy    String
  createdAt      DateTime @default(now())
  payment        Payment  @relation(fields: [paymentId], references: [id])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  message        String
  type           String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId, userId, isRead])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resourceType   String?
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  metadata       Json?
  timestamp      DateTime @default(now())

  @@index([organizationId, timestamp])
  @@index([resourceType, resourceId])
}

model FileAttachment {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String?
  storageKey     String
  fileName       String
  mimeType       String
  sizeBytes      Int
  uploadedBy     String
  createdAt      DateTime @default(now())

  @@index([organizationId, patientId])
}
