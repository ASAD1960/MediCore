{
    "name": "medicore-backend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsc -p .",
        "start": "node dist/src/server.js",
        "prisma:migrate": "prisma migrate dev",
        "prisma:generate": "prisma generate",
        "seed": "tsx prisma/seed.ts",
        "test": "vitest run tests"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "argon2": "^0.41.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "pino": "^9.5.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.9.0",
        "@types/supertest": "^6.0.2",
        "prisma": "^5.22.0",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vitest": "^2.1.5"
    },
    "allowScripts": {
        "@prisma/client@5.22.0": true,
        "@prisma/engines@5.22.0": true,
        "argon2@0.41.1": true,
        "prisma@5.22.0": true,
        "esbuild@0.28.2": true,
        "esbuild@0.21.5": true
    }
}
