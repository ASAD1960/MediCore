{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "medicore-backend": {
      "root": "medicore-backend",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "outputDirectory": "."
    },
    "medicore-frontend": {
      "root": "medicore-frontend",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "medicore-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "medicore-frontend"
      }
    }
  ]
}
